# Python and tools
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Editor extension files that are not part of this project
# (the IronBee DevTools extension writes this rule into every folder it opens)
.cursor/rules/ironbee-devtools-use.mdc

# Never commit archives or scratch files
*.zip
scratch/
.nbrun/

# Claude Code personal settings (the shared .claude/agents and .claude/settings.json ARE tracked)
.claude/settings.local.json

# Kiro CLI: the shared .kiro/agents, .kiro/prompts and .kiro/steering ARE tracked.
# Backups that /upgrade-agent writes, and any local Kiro settings, are not.
.kiro/agents/*.bak
.kiro/agents/*.bak.*
.kiro/settings/

# Kit files kept on your Mac only (START_HERE.md and the PDF copy of LAB_GUIDE.md)
/START_HERE.md
/LAB_GUIDE.pdf

# NOTE: CLAUDE.md, docs/decisions, docs/tracking, docs/adr, docs/reports, data/interim and
# data/processed are intentionally TRACKED. They are your proof of work.
