{
  "name": "notebook-runner",
  "description": "Executes the project notebooks top to bottom in a clean kernel, fixes MECHANICAL errors in code cells and src/ so they run, saves the executed notebooks, and reports. The only agent that edits code for mechanical fixes. Never edits markdown, decisions or data handling.",
  "prompt": "file://../prompts/notebook-runner.md",
  "tools": [
    "read",
    "glob",
    "grep",
    "write",
    "shell"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "data/raw/**",
          "docs/decisions/**",
          "docs/tracking/**",
          "docs/journals/**",
          "docs/adr/**",
          "docs/rca/**",
          "docs/specs/**",
          "docs/dataset_url.md",
          "docs/reports/README.md",
          "docs/reports/CHECKPOINT_SUMMARY_TEMPLATE.md",
          "tests/**",
          "scripts/**",
          ".github/**",
          ".claude/**",
          ".kiro/**",
          "requirements.txt",
          "pyproject.toml",
          ".pre-commit-config.yaml",
          "src/stroke_prep/config.py",
          "src/stroke_prep/__init__.py",
          "README.md",
          "LAB_GUIDE.md",
          "CLAUDE.md",
          "VALIDATION_PROTOCOL.md",
          "START_HERE.md",
          "LAB_GUIDE.pdf",
          "LICENSE"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/*.zip"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git tag*",
          "git remote*",
          "gh *",
          "curl *",
          "wget *"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "effect": "deny"
      },
      {
        "capability": "web_search",
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "notebooks/**",
          "src/stroke_prep/pipeline.py",
          "data/interim/**",
          "data/processed/**",
          ".nbrun/**",
          "docs/reports/notebook-runner/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "notebooks/**",
          "src/stroke_prep/pipeline.py",
          "data/interim/**",
          "data/processed/**",
          ".nbrun/**",
          "docs/reports/notebook-runner/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git add*",
          "git commit*",
          "git reset*",
          "git checkout*",
          "git restore*",
          "git stash*",
          "git rm*",
          "git mv*",
          "git clean*",
          "git rebase*",
          "git merge*",
          "git switch*",
          "pip install*",
          "pip uninstall*",
          "ruff check --fix*",
          "ruff format*",
          "git clone*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git status*",
          "git log*",
          "git diff*",
          "git show*",
          "python scripts/setup_gate.py*",
          "python3 scripts/setup_gate.py*",
          "python scripts/check_raw_hash.py*",
          "python3 scripts/check_raw_hash.py*",
          "python scripts/list_claims.py*",
          "python3 scripts/list_claims.py*",
          "python scripts/compare_outputs.py*",
          "python3 scripts/compare_outputs.py*",
          "python -m pytest -q -p no:cacheprovider*",
          "python3 -m pytest -q -p no:cacheprovider*",
          "jupyter nbconvert*",
          "mkdir -p .nbrun*",
          "cp .nbrun/*",
          "python -m pytest*",
          "python3 -m pytest*"
        ],
        "effect": "allow"
      }
    ]
  },
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "notebooks/**",
        "src/stroke_prep/pipeline.py",
        "data/interim/**",
        "data/processed/**",
        ".nbrun/**",
        "docs/reports/notebook-runner/**"
      ],
      "deniedPaths": [
        "data/raw",
        "docs/decisions",
        "docs/tracking",
        "docs/journals",
        "docs/adr",
        "docs/rca",
        "docs/specs",
        "docs/dataset_url.md",
        "docs/reports/README.md",
        "docs/reports/CHECKPOINT_SUMMARY_TEMPLATE.md",
        "tests",
        "scripts",
        ".github",
        ".claude",
        ".kiro",
        "requirements.txt",
        "pyproject.toml",
        ".pre-commit-config.yaml",
        "src/stroke_prep/config.py",
        "src/stroke_prep/__init__.py",
        "README.md",
        "LAB_GUIDE.md",
        "CLAUDE.md",
        "VALIDATION_PROTOCOL.md",
        "START_HERE.md",
        "LAB_GUIDE.pdf",
        "LICENSE",
        "docs/reports/RUN_LOG.md",
        ".gitignore"
      ]
    },
    "shell": {
      "allowedCommands": [
        "git status.*",
        "git log.*",
        "git diff.*",
        "git show.*",
        "python scripts/setup_gate\\.py.*",
        "python3 scripts/setup_gate\\.py.*",
        "python scripts/check_raw_hash\\.py.*",
        "python3 scripts/check_raw_hash\\.py.*",
        "python scripts/list_claims\\.py.*",
        "python3 scripts/list_claims\\.py.*",
        "python scripts/compare_outputs\\.py.*",
        "python3 scripts/compare_outputs\\.py.*",
        "python \\-m pytest \\-q \\-p no:cacheprovider.*",
        "python3 \\-m pytest \\-q \\-p no:cacheprovider.*",
        "jupyter nbconvert.*",
        "mkdir \\-p \\.nbrun.*",
        "cp \\.nbrun/.*",
        "python \\-m pytest.*",
        "python3 \\-m pytest.*"
      ],
      "deniedCommands": [
        "git push.*",
        "git tag.*",
        "git remote.*",
        "gh .*",
        "curl .*",
        "wget .*",
        "git add.*",
        "git commit.*",
        "git reset.*",
        "git checkout.*",
        "git restore.*",
        "git stash.*",
        "git rm.*",
        "git mv.*",
        "git clean.*",
        "git rebase.*",
        "git merge.*",
        "git switch.*",
        "pip install.*",
        "pip uninstall.*",
        "ruff check \\-\\-fix.*",
        "ruff format.*",
        "git clone.*"
      ]
    },
    "read": {
      "allowedPaths": [
        "./**"
      ],
      "deniedPaths": [
        "**/*.zip"
      ]
    }
  },
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "includeMcpJson": false,
  "welcomeMessage": "Notebook runner: runs notebooks in a fresh kernel, mechanical fixes only."
}
